# Copy this file to /opt/synapse/shared/.env and chmod it 600.
APP_DOMAIN=chat.example.com
ADMIN_DOMAIN=admin.chat.example.com
DOMAIN_CLIENT=https://chat.example.com
DOMAIN_SERVER=https://chat.example.com

# Pin these to digests before the first production deployment.
ADMIN_PANEL_IMAGE=registry.librechat.ai/clickhouse/librechat-admin-panel:latest
RAG_IMAGE=registry.librechat.ai/danny-avila/librechat-rag-api-dev-lite:latest

NODE_ENV=production
HOST=0.0.0.0
PORT=3080
RAG_PORT=8000
SEARCH=true
MEILI_HOST=http://meilisearch:7700
MEILI_NO_ANALYTICS=true
MEILI_MASTER_KEY=replace-with-a-long-random-value
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Generate these with: openssl rand -hex 32
CREDS_KEY=replace-with-64-hex-characters
CREDS_IV=replace-with-32-hex-characters
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-long-random-value
ADMIN_PANEL_SESSION_SECRET=replace-with-a-long-random-value
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

# Add model-provider keys and other LibreChat settings below.
