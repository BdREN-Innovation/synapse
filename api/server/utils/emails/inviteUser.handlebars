<!doctype html>
<html xmlns='http://www.w3.org/1999/xhtml' xmlns:v='urn:schemas-microsoft-com:vml'>
  <head>
    <meta http-equiv='Content-Type' content='text/html; charset=UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta name='x-apple-disable-message-reformatting' />
    <meta name='color-scheme' content='light' />
    <meta name='supported-color-schemes' content='light' />
    <title>{{appName}}</title>
    <style type='text/css'>
      body { margin: 0; padding: 0; background-color: #ffffff; }
      table, tr, td { border-collapse: collapse; }
      p { margin: 0; }
      a[x-apple-data-detectors='true'] { color: inherit !important; text-decoration: none !important; }
      @media only screen and (max-width: 520px) {
        .u-container { width: 100% !important; }
        .u-pad { padding-left: 24px !important; padding-right: 24px !important; }
      }
    </style>
  </head>

  <body
    style='margin:0;padding:0;background-color:#ffffff;-webkit-font-smoothing:antialiased;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'
  >
    <div
      style='display:none;font-size:1px;color:#ffffff;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;'
    >
      You have been invited to join {{appName}}.
    </div>

    <table role='presentation' width='100%' cellpadding='0' cellspacing='0' border='0'
      style='background-color:#ffffff;'>
      <tr>
        <td align='center' style='padding:32px 12px;'>

          <table role='presentation' class='u-container' width='500' cellpadding='0' cellspacing='0'
            border='0'
            style='width:500px;max-width:500px;background-color:#ffffff;background-image:url({{appUrl}}/assets/synapse-email-watermark.png);background-position:center 46%;background-repeat:no-repeat;border:1px solid #ece7f0;border-radius:14px;'
            background='{{appUrl}}/assets/synapse-email-watermark.png'>

            <tr>
              <td align='center' class='u-pad' style='padding:36px 40px 8px 40px;'>
                <img src='{{appUrl}}/assets/synapse-email-logo.png' alt='{{appName}}' width='150'
                  style='display:block;width:150px;max-width:150px;height:auto;border:0;outline:none;text-decoration:none;' />
              </td>
            </tr>

            <tr>
              <td class='u-pad' align='center' style='padding:16px 40px 0 40px;'>
                <h1
                  style='margin:0;font-size:24px;line-height:32px;font-weight:700;color:#9a278e;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                  You&rsquo;re invited
                </h1>
              </td>
            </tr>

            <tr>
              <td class='u-pad' align='center' style='padding:14px 40px 0 40px;'>
                <p
                  style='margin:0;font-size:15px;line-height:24px;color:#3f3646;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                  Hello{{#if name}} {{name}}{{/if}}, your institution has invited you to
                  {{appName}}. Set your password to activate your account.
                </p>
              </td>
            </tr>

            <tr>
              <td align='center' style='padding:28px 40px 0 40px;'>
                <table role='presentation' cellpadding='0' cellspacing='0' border='0'>
                  <tr>
                    <td align='center' bgcolor='#f5871f' style='border-radius:10px;'>
                      <!--[if mso]><v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{inviteLink}}" style="height:48px;v-text-anchor:middle;width:200px;" arcsize="20%" stroke="f" fillcolor="#f5871f"><w:anchorlock/><center style="color:#ffffff;font-family:Arial,sans-serif;font-size:16px;font-weight:bold;"><![endif]-->
                      <a href='{{inviteLink}}' target='_blank'
                        style='display:inline-block;padding:14px 34px;font-size:16px;font-weight:600;color:#ffffff;text-decoration:none;border-radius:10px;background-color:#f5871f;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                        Accept invitation
                      </a>
                      <!--[if mso]></center></v:roundrect><![endif]-->
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td class='u-pad' align='center' style='padding:24px 40px 0 40px;'>
                <p
                  style='margin:0;font-size:12px;line-height:20px;color:#7c7286;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                  If the button does not work, copy this link into your browser:
                </p>
                <p style='margin:8px 0 0 0;font-size:12px;line-height:20px;word-break:break-all;'>
                  <a href='{{inviteLink}}' target='_blank'
                    style='color:#9a278e;text-decoration:underline;'>{{inviteLink}}</a>
                </p>
              </td>
            </tr>

            <tr>
              <td class='u-pad' align='center' style='padding:24px 40px 0 40px;'>
                <p
                  style='margin:0;font-size:12px;line-height:20px;color:#7c7286;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                  This invitation expires in 7 days. If you were not expecting it, you can ignore
                  this message.
                </p>
              </td>
            </tr>

            <tr>
              <td class='u-pad' align='center' style='padding:28px 40px 36px 40px;'>
                <div style='border-top:1px solid #ece7f0;padding-top:18px;'>
                  <p
                    style='margin:0;font-size:11px;line-height:18px;color:#9a93a3;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;'>
                    &copy; {{year}} {{appName}} &middot; Bangladesh Research and Education Network
                  </p>
                </div>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
